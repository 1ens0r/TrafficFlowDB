DATABASE_URL=postgresql://traffic:trafficpass@localhost:5432/trafficflowdb
TRAFFIC_WINDOW_MINUTES=5
POLL_SECONDS=2
SIM_VEHICLES=60
SIM_INTERVAL_SEC=2.0
API_BASE_URL=http://localhost:8000

# --- TomTom Traffic API (optional, free tier ≈ 2,500 tx/day) ---
# 1. Get a key: https://developer.tomtom.com/ -> Dashboard -> API keys
# 2. Copy this file to .env (cp .env.example .env) and paste your key below.
# 3. Never commit .env (already in .gitignore). Leave empty to disable.
# Cost math: 86,400 / INTERVAL * BATCH + ~50 incident tx = tx/day.
# Defaults (300s × 4) ≈ 1,150/day — safe headroom for manual refreshes.
TOMTOM_API_KEY=
TOMTOM_ENABLED=true
TOMTOM_INTERVAL_SEC=300
TOMTOM_BATCH_SIZE=4
TOMTOM_DAILY_BUDGET=2000
